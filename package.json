{
  "name": "innesykkel",
  "version": "1.0.0",
  "private": true,
  "description": "Innesykkel desktop app for macOS",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac dir",
    "dist:mac": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "com.innesykkel.app",
    "productName": "Innesykkel",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "workouts.json",
      "electron/**/*",
      "assets/fonts/*",
      "assets/innesykkel.icns",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.sports",
      "icon": "assets/innesykkel.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Innesykkel bruker Bluetooth til å koble til smarttrainer, wattmåler og pulsbelte.",
        "NSBluetoothPeripheralUsageDescription": "Innesykkel bruker Bluetooth til å koble til smarttrainer, wattmåler og pulsbelte."
      }
    }
  }
}
